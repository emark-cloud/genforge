# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude harness transient state (settings.json is committed; lock files are not)
.claude/*.lock
.claude/scheduled_tasks*

# typescript
*.tsbuildinfo
next-env.d.ts

# frontend audit artifacts (script runs locally; screenshots + report are
# byproducts, not source)
/audit/

# python bytecode (the lint-service uses py3; never commit caches)
__pycache__/

# Internal-only design / spec / build docs — kept on disk for local reference
# (CLAUDE.md still points at them) but not published to GitHub.
/SPEC.md
/TODO.md
/DESIGN.md
/GUIDELINES.md
