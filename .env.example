# GenForge environment variables
#
# Copy to .env.local for local dev (Next.js loads it automatically) and set
# the same vars in the Vercel project for production.
#
# NEVER commit a populated .env.local — the .gitignore excludes it.

# ── Server-side LLM (powers the free tier) ─────────────────────────────────
# Locked to Gemini Flash for v1 per the GenForge plan; the field exists so we
# can swap providers later without an env-name churn.
SERVER_LLM_PROVIDER=gemini
SERVER_LLM_MODEL=gemini-2.5-flash
SERVER_LLM_KEY=

# ── Rate-limit store (Upstash Redis, REST mode) ────────────────────────────
# Create a database at https://console.upstash.com/redis and copy the REST
# URL + token into these vars.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Free-tier limits ───────────────────────────────────────────────────────
# Per-IP daily request cap. Counted across both Debug and Generate.
FREE_TIER_DAILY_LIMIT=5

# Global daily ceilings. When either is hit the server tier turns off until
# the next UTC day. Pick conservative values until the eval lands.
SERVER_LLM_DAILY_REQUEST_CAP=500
SERVER_LLM_DAILY_USD_CAP=5

# ── Logging hygiene ────────────────────────────────────────────────────────
# Salt used to sha256-hash IPs before they hit any log surface. Generate with
# `openssl rand -hex 32` and rotate occasionally.
IP_HASH_SALT=

# ── Lint microservice (optional) ───────────────────────────────────────────
# If both URL and SECRET are set, /api/debug pre-flights the user's contract
# through the linter and /api/{debug,generate} post-lint the model output.
# Lint is fail-open: any failure (unset, timeout, non-2xx) returns the LLM
# result with no `lint` field rather than erroring. See lint-service/README.md
# for deploy instructions.
LINT_SERVICE_URL=
LINT_SERVICE_SECRET=
LINT_TIMEOUT_MS=5000
